# Spring Boot <-> Supabase PostgreSQL (database only — no Auth keys)
# Copy to backend/.env and set DATABASE_PASSWORD. Never commit .env.
# If the password has special characters, keep it in DATABASE_PASSWORD (not the URL)
# so Spring percent-encodes it safely via the JDBC driver.

# Shared pooler (Session mode, port 5432) — matches Supabase Dashboard → Connect
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.bugglavpgdcmadcetjcs
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional cookie / CORS overrides for Render later:
# APISPY_COOKIE_SECURE=true
# APISPY_COOKIE_SAME_SITE=None
# APISPY_CORS_ORIGINS=https://your-frontend.onrender.com

# Password recovery email delivery (off until SMTP is configured):
# APISPY_MAIL_ENABLED=false

# Research administrators: comma-separated e-mails of accounts allowed into the research console.
# Register those accounts normally in the game; they are promoted at startup.
APISPY_ADMIN_EMAILS=
